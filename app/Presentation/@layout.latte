<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	{* Dynamický titulek: Pokud šablona nastaví {block title}, zobrazí se zde*}
	<title>{ifset title}{include title|stripHtml} | {/ifset}My E-shop</title>

	{asset? 'main.js'}
	{* bootstrap *}
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	{* FontAwesome *}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-light">
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
			<div class="container d-flex justify-content-between">
				<a class="navbar-brand" n:href="Home:default">My Eshop - Elektro</a>

				{* KOŠÍK: Zobrazení aktuálního stavu ze session *}

				<a n:href="Cart:default" class="text-decoration-none">
					<span class="navbar-text text-white">
						<i class="fas fa-shopping-cart"></i>
					</span>
					<span class="badge bg-primary">					
						{var $cartSession = $presenter->getSession('cart')}
						{ifset $cartSession->items}{count($cartSession->items)}{else}0{/ifset} 										
					</span>
				</a>
			</div>
		</nav>

		<div class="container bg-white p-4 shadow-sm rounded">
		{* Flash zprávy: Informační bubliny *}
			<div n:foreach="$flashes as $flash" n:class="alert, 'alert-' . $flash->type">{$flash->message}</div>

			{* Tady se vykreslí konkrétní stránky *}
			{include content}
		</div>

		<script src="https://unpkg.com/naja@2/dist/Naja.min.js"></script>
			<script>
    			naja.initialize();
			</script>
			<script src="https://unpkg.com/naja@2/dist/Naja.min.js"></script>
<style>
    /* Skrytí šipek pro Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Skrytí šipek pro Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    /* Vzhled políčka, aby vypadalo čistě */
    .ajax-input {
        border: none;
        background: transparent;
        outline: none;
        box-shadow: none !important;
    }
</style>
</body>
</html>
